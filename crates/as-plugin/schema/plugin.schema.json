{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tcmmi/AutoScene/main/crates/as-plugin/schema/plugin.schema.json",
  "title": "AutoScene plugin",
  "description": "plugin.json: what an AutoScene plugin is, what it says it does, and what it adds to AutoScene. docs/PLUGINS.md describes each key.",
  "type": "object",
  "required": ["manifestVersion", "id", "version", "name", "description", "author", "engines", "runtime"],
  "properties": {
    "$schema": {
      "description": "Where an editor finds this schema. AutoScene doesn't read it.",
      "type": "string"
    },
    "manifestVersion": {
      "description": "The version of plugin.json this file is written for. Version 2 adds pages, secret settings, and the runtime types service, none and wasm.",
      "enum": [1, 2]
    },
    "id": {
      "description": "A reverse domain name such as dev.example.my-plugin: 2 to 5 parts of lowercase letters, digits and dashes, joined by dots. It never changes.",
      "type": "string",
      "pattern": "^(?!(con|prn|aux|nul|com[0-9]|lpt[0-9])\\.)[a-z0-9]([a-z0-9-]{0,37}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,37}[a-z0-9])?){1,4}$"
    },
    "version": {
      "description": "A version number such as 1.2.0. An update needs a higher one.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "name": {
      "description": "The plugin's name, as AutoScene shows it.",
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "description": {
      "description": "What the plugin does, in a sentence or two.",
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "author": { "$ref": "#/$defs/author" },
    "license": {
      "description": "Its license, such as MIT.",
      "type": "string",
      "maxLength": 60
    },
    "repository": {
      "description": "Where its source is: an https:// link.",
      "$ref": "#/$defs/link"
    },
    "engines": { "$ref": "#/$defs/engines" },
    "platforms": {
      "description": "Where it runs. Left out, it runs everywhere its command does.",
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": ["windows-x86_64", "windows-aarch64", "macos-aarch64", "macos-x86_64", "linux-x86_64", "linux-aarch64"]
      }
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "permissions": {
      "description": "What it says it does. AutoScene shows them before install, and holds its calls into AutoScene to them.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/permission" }
    },
    "network": { "$ref": "#/$defs/network" },
    "contributes": { "$ref": "#/$defs/contributes" },
    "icon": {
      "description": "A .png or .svg file in the plugin, such as icon.svg.",
      "type": "string",
      "pattern": "\\.([pP][nN][gG]|[sS][vV][gG])$"
    },
    "banner": {
      "description": "With manifestVersion 2: wide art, a .png, .jpg or .webp file of at most 512 KB in the plugin, best 2:1 (1200x600).",
      "type": "string",
      "pattern": "\\.([pP][nN][gG]|[jJ][pP][eE]?[gG]|[wW][eE][bB][pP])$"
    },
    "resources": {
      "description": "With manifestVersion 2: large files the plugin's program needs, such as a model's weights. AutoScene gets each at the plugin's first run, keeps it by its hash, and hands the program their folder (AUTOSCENE_RESOURCES); a WebAssembly plugin reads them, read only, at /resources.",
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "required": ["manifestVersion"], "properties": { "manifestVersion": { "const": 1 } } },
      "then": {
        "properties": {
          "banner": false,
          "resources": false,
          "runtime": { "properties": { "type": { "const": "process" }, "component": false, "limits": false } },
          "contributes": {
            "properties": {
              "pages": false,
              "settings": { "items": { "properties": { "type": { "not": { "const": "secret" } } } } }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["runtime"],
        "properties": { "runtime": { "required": ["type"], "properties": { "type": { "const": "none" } } } }
      },
      "then": {
        "required": ["contributes"],
        "properties": {
          "platforms": false,
          "resources": { "maxItems": 0 },
          "runtime": { "properties": { "command": false, "gpu": false, "component": false, "limits": false } },
          "contributes": {
            "required": ["pages"],
            "properties": { "exportActions": false, "commands": false, "pages": { "minItems": 1 } }
          }
        }
      }
    },
    {
      "if": {
        "required": ["runtime"],
        "properties": { "runtime": { "required": ["type"], "properties": { "type": { "enum": ["process", "service"] } } } }
      },
      "then": {
        "properties": { "runtime": { "required": ["command"], "properties": { "component": false, "limits": false } } }
      }
    },
    {
      "if": {
        "required": ["runtime"],
        "properties": { "runtime": { "required": ["type"], "properties": { "type": { "const": "wasm" } } } }
      },
      "then": {
        "properties": { "runtime": { "required": ["component"], "properties": { "command": false, "gpu": { "const": false } } } }
      }
    },
    {
      "if": {
        "required": ["runtime"],
        "properties": { "runtime": { "required": ["type"], "properties": { "type": { "const": "service" } } } }
      },
      "then": {
        "properties": { "engines": { "properties": { "protocol": { "const": 2 } } } }
      }
    },
    {
      "if": {
        "required": ["network"],
        "properties": { "network": { "required": ["hosts"], "properties": { "hosts": { "minItems": 1 } } } }
      },
      "then": {
        "required": ["permissions"],
        "properties": { "permissions": { "contains": { "const": "network" } } }
      }
    }
  ],
  "$defs": {
    "link": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "^https://[^\\s@/\\\\?#]+([/?#][^\\s\\\\]*)?$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "contributionId": {
      "description": "Lowercase letters, digits and dashes (at most 32). Unique in its list.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "author": {
      "description": "Who made it.",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/label", "maxLength": 60 },
        "url": { "description": "An https:// link.", "$ref": "#/$defs/link" }
      },
      "additionalProperties": false
    },
    "engines": {
      "description": "The AutoScene it works with, and the protocol its program speaks.",
      "type": "object",
      "required": ["autoscene", "protocol"],
      "properties": {
        "autoscene": {
          "description": "The AutoScene versions it works with, as Cargo writes them, with commas between the parts: \">=1.1.0, <2\".",
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "[0-9A-Za-z*]\\s+[<>=~^]" }
        },
        "protocol": {
          "description": "The protocol its program and pages speak. 2 adds calls into AutoScene, services and page runs.",
          "enum": [1, 2]
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "description": "How it runs.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "description": "process: its program starts for each run. service: it also runs while one of its pages is open (protocol 2). none: it runs no program, and has only pages. wasm: its WebAssembly component runs in AutoScene's sandbox for each run (manifest version 2).",
          "enum": ["process", "service", "none", "wasm"]
        },
        "command": {
          "description": "The command per platform, or \"*\" for every other one. A program in the plugin's folder, or a Python script as [\"uv\", \"run\", \"--script\", \"--locked\", \"main.py\"].",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": ["*", "windows-x86_64", "windows-aarch64", "macos-aarch64", "macos-x86_64", "linux-x86_64", "linux-aarch64"]
          },
          "additionalProperties": { "$ref": "#/$defs/commandLine" }
        },
        "gpu": {
          "description": "It uses the GPU, so its runs wait for the analysis to leave it free.",
          "type": "boolean"
        },
        "component": {
          "description": "Its WebAssembly component (wasm only): a .wasm file in the plugin's folder, such as plugin.wasm.",
          "type": "string",
          "pattern": "^(?!(.*/)?\\.\\.?(/|$))([A-Za-z0-9._@+-]+/)*[A-Za-z0-9._@+-]+\\.wasm$"
        },
        "limits": { "$ref": "#/$defs/limits" }
      },
      "additionalProperties": false
    },
    "limits": {
      "description": "What each run of its component may take (wasm only). Left out, each is its default.",
      "type": "object",
      "properties": {
        "memoryMb": {
          "description": "The memory a run may use, in MB.",
          "type": "integer",
          "minimum": 16,
          "maximum": 4096,
          "default": 512
        },
        "minutes": {
          "description": "How long a run may take, in minutes. A longer one is stopped.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1440,
          "default": 30
        }
      },
      "additionalProperties": false
    },
    "commandLine": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "maxLength": 256 }
    },
    "permission": {
      "enum": ["exports:read", "exports:write", "project:read", "network"]
    },
    "resource": {
      "description": "A large file, got from one of its addresses and kept only with its size and SHA-256.",
      "type": "object",
      "required": ["name", "urls", "sha256", "size"],
      "properties": {
        "name": {
          "description": "Its file name in the plugin's folder of resources: letters, digits and . _ @ + -, unique in any case, not ending in .part, .verified, .lock, .unpacked or .archive.",
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9._@+-]*[A-Za-z0-9_@+-]$"
        },
        "urls": {
          "description": "Where it comes from, tried in turn: plain https:// addresses of hosts on the internet, on port 443. On Hugging Face, pin a revision (resolve/<40 hex digits>/), never a branch.",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/link" }
        },
        "sha256": {
          "description": "Its SHA-256: 64 lowercase hex digits.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "description": "Its size in bytes: at most 4 GiB, and all of a plugin's at most 8 GiB.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        }
      },
      "additionalProperties": false
    },
    "network": {
      "description": "Where it connects. Needs the network permission.",
      "type": "object",
      "properties": {
        "hosts": {
          "description": "Lowercase host names such as discord.com, without a scheme or a port.",
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
          }
        }
      },
      "additionalProperties": false
    },
    "contributes": {
      "description": "What it adds to AutoScene.",
      "type": "object",
      "properties": {
        "exportActions": {
          "description": "Entries of an export's menu.",
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/exportAction" }
        },
        "commands": {
          "description": "Entries of the command palette.",
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/command" }
        },
        "settings": {
          "description": "Settings AutoScene shows in the plugin's settings and hands to each run. At most 8 of them are secrets.",
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/setting" },
          "contains": { "required": ["type"], "properties": { "type": { "const": "secret" } } },
          "minContains": 0,
          "maxContains": 8
        },
        "pages": {
          "description": "Pages AutoScene shows full screen, in a sandboxed frame (manifest version 2).",
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/page" }
        }
      },
      "additionalProperties": false
    },
    "exportAction": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": { "$ref": "#/$defs/label", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": { "$ref": "#/$defs/label", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 200 },
        "needsProject": {
          "description": "Offered only while a project is open, and run with it.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "setting": {
      "type": "object",
      "required": ["key", "type", "title"],
      "properties": {
        "key": {
          "description": "A lowercase letter, then letters, digits and _ (at most 40). No two keys differ only in capitals.",
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_]{0,39}$"
        },
        "type": {
          "description": "What it holds. A secret (manifest version 2) is kept in the system's keychain, and has no default.",
          "enum": ["string", "number", "boolean", "select", "secret"]
        },
        "title": { "$ref": "#/$defs/label", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 200 }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "string" } } },
          "then": {
            "properties": {
              "default": { "type": "string" },
              "placeholder": { "type": "string", "maxLength": 200 },
              "maxLength": { "type": "integer", "minimum": 1, "maximum": 2000 }
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "number" } } },
          "then": {
            "properties": {
              "default": { "type": "number" },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "step": { "type": "number", "exclusiveMinimum": 0 },
              "integer": { "type": "boolean" }
            },
            "if": { "required": ["integer"], "properties": { "integer": { "const": true } } },
            "then": { "properties": { "default": { "type": "integer" } } }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "boolean" } } },
          "then": {
            "properties": {
              "default": { "type": "boolean" }
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "select" } } },
          "then": {
            "required": ["options"],
            "properties": {
              "options": {
                "description": "Its choices, each with a value of its own.",
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": { "$ref": "#/$defs/option" }
              },
              "default": { "description": "One of its options' values.", "type": "string" }
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "secret" } } },
          "then": {
            "properties": {
              "placeholder": { "type": "string", "maxLength": 200 }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "option": {
      "type": "object",
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "maxLength": 200 },
        "label": { "$ref": "#/$defs/label", "maxLength": 60 }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["id", "title", "entry"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": { "$ref": "#/$defs/label", "maxLength": 40 },
        "description": { "type": "string", "maxLength": 200 },
        "entry": {
          "description": "Its file: an .html file under ui/, such as ui/index.html.",
          "type": "string",
          "pattern": "^ui/[A-Za-z0-9._@+/-]+\\.html$"
        },
        "scope": {
          "description": "global: it opens on its own, from the rail or the palette. project: it opens in a project, from the project's bar, and may read that project.",
          "enum": ["global", "project"]
        },
        "rail": {
          "description": "It has a tile in AutoScene's rail (global pages only).",
          "type": "boolean"
        }
      },
      "if": { "required": ["scope"], "properties": { "scope": { "const": "project" } } },
      "then": { "properties": { "rail": { "const": false } } },
      "additionalProperties": false
    }
  }
}
